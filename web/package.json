{
  "name": "billmind-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BillMind 2.0 — minimal web client (Voyage)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../contract/openapi.yaml -o src/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.0.20",
    "@fontsource/noto-serif": "^5.0.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "openapi-typescript": "^7.4.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
