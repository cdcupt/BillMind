# Copy to `.env` on the VPS and fill in. NEVER commit the real .env.
# (The real OpenAI moderation key lives in ~/.openai/keys.env locally and is
#  copied here at deploy time.)

# Public domain Caddy serves with automatic TLS
DOMAIN=api.billmind.example.com

# Postgres
POSTGRES_PASSWORD=change-me-strong
# DATABASE_URL is assembled by docker-compose from POSTGRES_PASSWORD; override to point elsewhere.

# Auth — session signing + OIDC client ids
JWT_SIGNING_KEY=change-me-at-least-32-bytes-of-random
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
GOOGLE_CLIENT_ID=

# AI — recognition + chat (Gemini) and the moderation gate (OpenAI, free endpoint)
GEMINI_API_KEY=
OPENAI_MODERATION_KEY=

# Receipt-image encryption (app-level AES-GCM)
BLOB_MASTER_KEY=change-me-32-bytes

# Off-box backups → Cloudflare R2 (restic)
R2_BUCKET=billmind-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
