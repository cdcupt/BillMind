# BillMind 2.0 — Caddy reverse proxy with automatic HTTPS.
# Domains come from .env (API_DOMAIN, WEB_DOMAIN). Caddy obtains and renews
# Let's Encrypt certs automatically.

# API — terminates TLS, proxies to the Vapor server on the internal network.
{$API_DOMAIN} {
	encode zstd gzip

	# Security headers (see rules/ecc/web/security.md).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy server:8080 {
		# Stream SSE (agent chat) without buffering.
		flush_interval -1
	}
}

# Web — static SPA. The dist/ is mounted read-only at /srv/web.
{$WEB_DOMAIN} {
	encode zstd gzip
	root * /srv/web

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Long-cache fingerprinted assets; never cache the HTML shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# SPA fallback — unknown paths serve index.html.
	try_files {path} /index.html
	file_server
}
