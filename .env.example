# BillMind 2.0 — deployment configuration. Copy to `.env` and fill in.
# NEVER commit the real .env (it is gitignored).

# ── Domains (Caddy auto-HTTPS) ───────────────────────────────────────────────
API_DOMAIN=api.billmind.app
WEB_DOMAIN=app.billmind.app

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=billmind
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=billmind

# ── Server secrets ───────────────────────────────────────────────────────────
# HS256 session signing key. Generate: openssl rand -hex 48
JWT_SIGNING_KEY=change-me-openssl-rand-hex-48

# OIDC audiences — must match the client app IDs that mint the ID tokens.
APPLE_CLIENT_ID=app.billmind.signin
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# ── AI providers ─────────────────────────────────────────────────────────────
# Gemini: agent chat + photo recognition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI omni-moderation (free) — input moderation gate.
OPENAI_MODERATION_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
